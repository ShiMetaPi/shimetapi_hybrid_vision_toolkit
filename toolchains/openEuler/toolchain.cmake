# Cross-build against the openEuler target sysroot, never host USB/OpenCV libs.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(OPENEULER_SYSROOT "$ENV{OPENEULER_SYSROOT}" CACHE PATH "openEuler target development sysroot")
set(OPENEULER_TOOLCHAIN_PREFIX "$ENV{OPENEULER_TOOLCHAIN_PREFIX}" CACHE STRING "Compiler prefix without trailing dash")
if(NOT OPENEULER_TOOLCHAIN_PREFIX)
    set(OPENEULER_TOOLCHAIN_PREFIX "aarch64-openeuler-linux-gnu")
endif()
if(NOT IS_DIRECTORY "${OPENEULER_SYSROOT}/usr/include")
    message(FATAL_ERROR "Set OPENEULER_SYSROOT to an openEuler development sysroot with usr/include")
endif()
set(CMAKE_C_COMPILER "${OPENEULER_TOOLCHAIN_PREFIX}-gcc")
set(CMAKE_CXX_COMPILER "${OPENEULER_TOOLCHAIN_PREFIX}-g++")
set(CMAKE_SYSROOT "${OPENEULER_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${OPENEULER_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OPENEULER_SYSROOT OPENEULER_TOOLCHAIN_PREFIX)

set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${OPENEULER_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${OPENEULER_SYSROOT}/usr/lib64/pkgconfig:${OPENEULER_SYSROOT}/usr/lib/pkgconfig:${OPENEULER_SYSROOT}/lib64/pkgconfig:${OPENEULER_SYSROOT}/lib/pkgconfig:${OPENEULER_SYSROOT}/usr/share/pkgconfig")
